# Error/Warning Origin ID Configuration for THIS_BOARD
#
# Format: origin_id=N  (where N is a unique number for this board)
#
# The full error/warning ID will be: [origin_id].[local_id]
# Example: With origin_id=200, errors would be 0.1, 0.2, 0.3, etc.
#
# If you change this, the formatter will generate new IDs with the new origin prefix.
#
# Each board/origin should have a unique origin_id to prevent collisions:
#   0 = THIS_BOARD (core firmware)
#   1 = ST-LIB
#   2 = LCU board
#   etc.
#
# You can also override via environment variable: ERROR_WARNING_CORE_ID
#

origin_id=200
